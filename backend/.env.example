# Copy to backend/.env (git-ignored) and fill in from
# Supabase dashboard -> Project Settings -> API Keys / Data API.

SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co

# Publishable / anon key (sb_publishable_... or the legacy anon JWT). Safe for the browser.
SUPABASE_ANON_KEY=

# Secret / service_role key (sb_secret_... or the legacy service_role JWT).
# Server only: bypasses row-level security. Never prefix with VITE_, never commit.
SUPABASE_SERVICE_ROLE_KEY=

# Frontend copies (only the public values; Vite exposes VITE_* to the browser)
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=

# Gemini reads every care note (app/models/note_reader.py: language, English translation,
# observations, serious events; the backend checks each quote against the note) and writes
# alert summaries. Server only, never VITE_. Get a key at https://aistudio.google.com/apikey
# Without a key, notes are read by the rules only.
GEMINI_API_KEY=
# Optional: the model that reads notes (default gemini-3.5-flash-lite, falls back to
# gemini-3.1-flash-lite). GEMINI_MODEL also sets the summary model.
# GEMINI_NOTE_MODEL=
# GEMINI_MODEL=
# HUNCH_AI_READ=0    turn Gemini note reading off

# Nurse sign-in. With Supabase, create accounts with: python -m scripts.create_nurse
# Demo mode (no Supabase): the four nurses in test_data/people.json sign in with this password.
# HUNCH_DEMO_PASSWORD=hunch-demo
