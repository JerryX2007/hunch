{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "cd frontend && npm ci && npm run build",
  "functions": {
    "server.py": {
      "maxDuration": 60,
      "excludeFiles": "{frontend/node_modules/**,frontend/src/**,frontend/public/**,ML/**,db/**,backend/tests/**,backend/scripts/**,**/__pycache__/**,.venv/**,plan.md}"
    }
  }
}
